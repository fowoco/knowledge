{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fowoco.local/schemas/workflow-catalog.schema.json",
  "title": "FOWOCO Workflow Catalog",
  "type": "object",
  "required": ["version", "policy", "workflows", "case_templates"],
  "properties": {
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "policy": { "type": "object" },
    "workflows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "intent",
          "domains",
          "sensitivity",
          "supported_input_modes",
          "triggers",
          "required_slots_ref",
          "source_ids",
          "steps",
          "completion_evidence"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^WF-[A-Z]{3}(?:-[A-Z]{3})?-[0-9]{3}$" },
          "name": { "type": "string", "minLength": 2 },
          "intent": { "type": "string" },
          "domains": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" },
            "uniqueItems": true
          },
          "sensitivity": { "enum": ["low", "medium", "high", "critical"] },
          "supported_input_modes": {
            "type": "array",
            "minItems": 1,
            "items": { "enum": ["WORKER_MESSAGE", "AGENT_TASK", "INTERNAL_REQUEST"] },
            "uniqueItems": true
          },
          "triggers": { "type": "array", "minItems": 1 },
          "required_slots_ref": { "type": "string" },
          "source_ids": {
            "type": "array",
            "items": { "type": "string", "pattern": "^SRC-" },
            "uniqueItems": true
          },
          "checklist_id": { "type": "string", "pattern": "^CHK-" },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "actor", "action", "output"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]+$" },
                "actor": { "type": "string" },
                "action": { "type": "string", "minLength": 5 },
                "output": { "type": "string" },
                "gate": { "type": "string" }
              },
              "additionalProperties": false
            }
          },
          "completion_evidence": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    },
    "case_templates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "intent", "workflow_ids", "tasks"],
        "properties": {
          "id": { "type": "string", "pattern": "^CASE-[A-Z0-9-]+-[0-9]{3}$" },
          "name": { "type": "string", "minLength": 2 },
          "intent": { "type": "string" },
          "workflow_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^WF-[A-Z]{3}(?:-[A-Z]{3})?-[0-9]{3}$" },
            "uniqueItems": true
          },
          "tasks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "key",
                "order",
                "task_type",
                "workflow_id",
                "title",
                "description",
                "activation",
                "depends_on",
                "depends_on_if_present",
                "checklist_items",
                "completion_evidence"
              ],
              "properties": {
                "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]+$" },
                "order": { "type": "integer", "minimum": 1 },
                "task_type": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
                "workflow_id": { "type": "string", "pattern": "^WF-[A-Z]{3}(?:-[A-Z]{3})?-[0-9]{3}$" },
                "title": { "type": "string", "minLength": 2 },
                "description": { "type": "string", "minLength": 5 },
                "activation": {
                  "type": "object",
                  "required": ["mode"],
                  "properties": {
                    "mode": { "enum": ["ALWAYS", "MISSING_ANY"] },
                    "field_keys": {
                      "type": "array",
                      "minItems": 1,
                      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]+$" },
                      "uniqueItems": true
                    }
                  },
                  "allOf": [
                    {
                      "if": { "properties": { "mode": { "const": "MISSING_ANY" } } },
                      "then": { "required": ["field_keys"] }
                    }
                  ],
                  "additionalProperties": false
                },
                "depends_on": {
                  "type": "array",
                  "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]+$" },
                  "uniqueItems": true
                },
                "depends_on_if_present": {
                  "type": "array",
                  "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]+$" },
                  "uniqueItems": true
                },
                "checklist_items": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["item_code", "label", "required"],
                    "properties": {
                      "item_code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
                      "label": { "type": "string", "minLength": 2 },
                      "required": { "type": "boolean" }
                    },
                    "additionalProperties": false
                  }
                },
                "completion_evidence": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]+$" },
                  "uniqueItems": true
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
